{
  "name": "solidjs-motion-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun --filter '*' build",
    "dev": "bun --filter basic dev",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "bun --filter '*' clean && rm -rf node_modules",
    "example:basic": "bun --filter basic dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "basic": "workspace:*",
    "solid-devtools": "^0.34.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14"
}
