{
  "name": "@solidjs-motion/motion",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./src/index.ts",
  "publish": {
    "include": ["src", "README.md", "CHANGELOG.md", "LICENSE", "jsr.json"],
    "exclude": ["**/*.test.ts", "**/*.test.tsx", "tests/"]
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js"
  },
  "imports": {
    "solid-js": "npm:solid-js@^1.9.0",
    "solid-js/web": "npm:solid-js@^1.9.0/web",
    "solid-js/store": "npm:solid-js@^1.9.0/store",
    "solid-js/jsx-runtime": "npm:solid-js@^1.9.0/jsx-runtime",
    "motion": "npm:motion@^12.0.0",
    "motion-dom": "npm:motion-dom@^12.0.0",
    "@solid-primitives/refs": "npm:@solid-primitives/refs@^1.1.3",
    "@solid-primitives/transition-group": "npm:@solid-primitives/transition-group@^1.1.2"
  }
}
